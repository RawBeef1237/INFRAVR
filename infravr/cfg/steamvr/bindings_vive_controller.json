{
  "action_manifest_version": 0,
  "category": "steamvr_input",
  "controller_type": "vive_controller",
  "name": "INFRA VR default (vive_controller)",
  "description": "INFRA VR default bindings",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/main/in/Move"
            },
            "click": {
              "output": "/actions/main/in/Sprint"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/main/in/Turn"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/Jump"
            }
          }
        },
        {
          "path": "/user/hand/right/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/Crouch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/Pause"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/UseLeft"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/UseRight"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/GripLeft"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/GripRight"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/main/in/PoseLeft",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/main/in/PoseRight",
          "path": "/user/hand/right/pose/tip"
        }
      ],
      "skeleton": [
        {
          "output": "/actions/main/in/SkeletonLeft",
          "path": "/user/hand/left/input/skeleton/left"
        },
        {
          "output": "/actions/main/in/SkeletonRight",
          "path": "/user/hand/right/input/skeleton/right"
        }
      ],
      "haptics": [
        {
          "output": "/actions/main/out/HapticLeft",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/main/out/HapticRight",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  }
}